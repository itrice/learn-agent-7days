{
	"name": "Python Development",
	"dockerComposeFile": [
		"../devCompose.yaml",
		"docker-compose.yml"
	],
	"service": "python-dev",
	"workspaceFolder": "/app",
	"forwardPorts": [
		8000
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance"
			],
			"settings": {
				"python.defaultInterpreterPath": "/usr/local/bin/python",
				"python.terminal.activateEnvironment": true
			}
		}
	}
}
